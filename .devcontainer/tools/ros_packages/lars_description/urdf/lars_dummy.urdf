<?xml version="1.0"?>
<robot name="lars_dummy">
  <material name="lars_body_blue">
    <color rgba="0.05 0.22 0.95 1.0"/>
  </material>
  <material name="lars_dark">
    <color rgba="0.02 0.025 0.03 1.0"/>
  </material>
  <material name="lars_tread">
    <color rgba="0.12 0.13 0.14 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.32 0.10"/>
      </geometry>
      <material name="lars_body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.32 0.10"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.045"/>
      </geometry>
      <material name="lars_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.048"/>
      </geometry>
      <material name="lars_tread"/>
    </visual>
  </link>

  <joint name="front_left_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.21 0.215 0.055" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.65" upper="0.65" effort="2.0" velocity="3.0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.045"/>
      </geometry>
      <material name="lars_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.048"/>
      </geometry>
      <material name="lars_tread"/>
    </visual>
  </link>

  <joint name="front_right_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.21 -0.215 0.055" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.65" upper="0.65" effort="2.0" velocity="3.0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.045"/>
      </geometry>
      <material name="lars_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.048"/>
      </geometry>
      <material name="lars_tread"/>
    </visual>
  </link>

  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.21 0.215 0.055" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.045"/>
      </geometry>
      <material name="lars_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.048"/>
      </geometry>
      <material name="lars_tread"/>
    </visual>
  </link>

  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.21 -0.215 0.055" rpy="0 0 0"/>
  </joint>
</robot>
