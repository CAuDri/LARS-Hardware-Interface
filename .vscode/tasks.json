{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open STM32CubeMX",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/script/container_open_cubemx.sh",
            "args": [
                "--device",
                "${input:cubemxDevice}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true,
                "close": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Connect micro-ROS Agent",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/script/container_start_microros_agent.sh",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true,
                "close": true
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Launch ROS RViz",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/script/container_start_lars_visualizer.sh",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true,
                "close": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Launch ROS Visualizer",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/script/container_start_lars_lichtblick.sh",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true,
                "close": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ],
    "inputs": [
        {
            "id": "cubemxDevice",
            "type": "pickString",
            "description": "Select the device configuration to open in STM32CubeMX:",
            "options": [
                "HardwareInterface"
            ],
            "default": "HardwareInterface"
        }
    ]
}
