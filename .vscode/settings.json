{
    "actionButtons": {
        "defaultColor": "#FFFFFF",
        "loadNpmCommands": false,
        "reloadButton": null,
        "commands": [
            {
                "name": "$(debug-alt) Start Debugger",
                "tooltip": "Start a debugging session with a connected device",
                "color": "lightgreen",
                "useVsCodeApi": true,
                "command": "workbench.action.debug.start"
            },
            {
                "name": "$(console) Serial Monitor",
                "tooltip": "Open the serial monitor to communicate with a serial device",
                "color": "lightgrey",
                "useVsCodeApi": true,
                "command": "workbench.view.extension.vscode-serial-monitor-tools"
            },
            {
                "name": "$(debug-disconnect) Micro-ROS Agent",
                "tooltip": "Select a connected serial device and start the micro-ROS agent",
                "color": "orange",
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "Connect micro-ROS Agent"
                ],
            },
            {
                "name": "$(symbol-misc) STM32 CubeMX",
                "tooltip": "Select a device configuration and open it in STM32CubeMX",
                "color": "#32A9DC",
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "Open STM32CubeMX"
                ]
            },
            {
                "name": "$(browser) ROS Visualizer",
                "tooltip": "Start the local Lichtblick dashboard and ROS WebSocket bridge",
                "color": "#9b7cff",
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "Launch ROS Visualizer"
                ]
            },
        ]
    },
    "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-g++",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/firmware/devices/HardwareInterface/build/compile_commands.json"
}
